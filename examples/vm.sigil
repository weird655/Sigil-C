#include <stdio.h>

/* ------------------------------------------------------------------
   最小可移植虚拟机（Sigil-C v1.1）

   - 只用 C99 + 定宽整数，不调用任何平台 API
   - 指令以 (op, arg) 结构解码，字节码是纯数据，与平台无关
   - 位宽假设用 t! 写在源码里，后端不满足就编译失败
   - 同一台 VM 依次运行两段不同的字节码
   ------------------------------------------------------------------ */

#define CODE_CAP 64
#define STACK_CAP 32
#define REG_COUNT 8
#define TRACE 0          /* 改成 1 可以看逐条指令轨迹 */

t! (z? i4 == 4, "i4 must be 32-bit");
t! (z? u4 == 4, "u4 must be 32-bit");

e{ Op {
    OP_PUSH m, 0, OP_ADD m, 1, OP_SUB m, 2, OP_MUL m, 3,
    OP_JZ m, 4, OP_JMP m, 5, OP_LOAD m, 6, OP_STORE m, 7,
    OP_EMIT m, 8, OP_HALT m, 9,
};

s{ Inst { Op op; i4 arg; };

s{ VM {
    Inst[CODE_CAP] code;
    u4 code_len;
    i4[STACK_CAP] stack;
    u4 sp;
    u4 sp_peak;
    i4[REG_COUNT] regs;
    u4 pc;
    u4 ticks;
    u4 halted;
};

o! (p* c@ c1)[10] NAMES m, {
    "PUSH", "ADD", "SUB", "MUL", "JZ", "JMP", "LOAD", "STORE", "EMIT", "HALT",
};

v. fault(p* VM vm) { vm->halted m, 1; }

v. push(p* VM vm, i4 v) {
    i? (vm->sp >= STACK_CAP) { fault(vm); }
    e: {
        vm->stack[vm->sp] m, v;
        vm->sp m+ 1;
        i? (vm->sp > vm->sp_peak) { vm->sp_peak m, vm->sp; }
    }
}

i4 pop(p* VM vm) {
    i? (vm->sp == 0) { fault(vm); r; 0; }
    o! i4 v m, vm->stack[vm->sp - 1];
    vm->sp m- 1;
    r; v;
}

v. op_push(p* VM vm) { push(vm, vm->code[vm->pc].arg); vm->pc m+ 1; }
v. op_add(p* VM vm) { o! i4 b m, pop(vm); o! i4 a m, pop(vm); push(vm, a + b); vm->pc m+ 1; }
v. op_sub(p* VM vm) { o! i4 b m, pop(vm); o! i4 a m, pop(vm); push(vm, a - b); vm->pc m+ 1; }
v. op_mul(p* VM vm) { o! i4 b m, pop(vm); o! i4 a m, pop(vm); push(vm, a * b); vm->pc m+ 1; }

v. op_jz(p* VM vm) {
    o! i4 c m, pop(vm);
    i? (c == 0) { vm->pc m, vm->code[vm->pc].arg; }
    e: { vm->pc m+ 1; }
}

v. op_jmp(p* VM vm) { vm->pc m, vm->code[vm->pc].arg; }

v. op_load(p* VM vm) {
    o! i4 i m, vm->code[vm->pc].arg;
    i? (i < 0 || i >= REG_COUNT) { fault(vm); }
    e: { push(vm, vm->regs[i]); vm->pc m+ 1; }
}

v. op_store(p* VM vm) {
    o! i4 i m, vm->code[vm->pc].arg;
    o! i4 v m, pop(vm);
    i? (i < 0 || i >= REG_COUNT) { fault(vm); }
    e: { vm->regs[i] m, v; vm->pc m+ 1; }
}

v. op_emit(p* VM vm) { printf("%d\n", pop(vm)); vm->pc m+ 1; }
v. op_halt(p* VM vm) { vm->halted m, 1; }

/* 函数指针分派表：C 里最难写的那类声明，在这里是一条直线 */
o! (f^(p* VM) -> v.)[10] DISPATCH m, {
    op_push, op_add, op_sub, op_mul, op_jz,
    op_jmp, op_load, op_store, op_emit, op_halt,
};

v. reset(p* VM vm) {
    vm->code_len m, 0;
    vm->sp m, 0;
    vm->sp_peak m, 0;
    vm->pc m, 0;
    vm->ticks m, 0;
    vm->halted m, 0;
}

v. encode(p* VM vm, Op op, i4 arg) {
    i? (vm->code_len >= CODE_CAP) { fault(vm); }
    e: {
        vm->code[vm->code_len].op m, op;
        vm->code[vm->code_len].arg m, arg;
        vm->code_len m+ 1;
    }
}

/* 程序一：acc = 1 + 2 + ... + 10 */
v. load_sum(p* VM vm) {
    encode(vm, OP_PUSH, 0);        /*  0: acc = 0        */
    encode(vm, OP_STORE, 0);       /*  1                 */
    encode(vm, OP_PUSH, 10);       /*  2: n = 10         */
    encode(vm, OP_STORE, 1);       /*  3                 */
    encode(vm, OP_LOAD, 1);        /*  4: loop: push n   */
    encode(vm, OP_JZ, 15);         /*  5: n == 0 -> end  */
    encode(vm, OP_LOAD, 0);        /*  6: acc += n       */
    encode(vm, OP_LOAD, 1);        /*  7                 */
    encode(vm, OP_ADD, 0);         /*  8                 */
    encode(vm, OP_STORE, 0);       /*  9                 */
    encode(vm, OP_LOAD, 1);        /* 10: n -= 1         */
    encode(vm, OP_PUSH, 1);        /* 11                 */
    encode(vm, OP_SUB, 0);         /* 12                 */
    encode(vm, OP_STORE, 1);       /* 13                 */
    encode(vm, OP_JMP, 4);         /* 14: goto loop      */
    encode(vm, OP_LOAD, 0);        /* 15: push acc       */
    encode(vm, OP_EMIT, 0);        /* 16: print          */
    encode(vm, OP_HALT, 0);        /* 17                 */
}

/* 程序二：7 * 6 */
v. load_mul(p* VM vm) {
    encode(vm, OP_PUSH, 7);
    encode(vm, OP_PUSH, 6);
    encode(vm, OP_MUL, 0);
    encode(vm, OP_EMIT, 0);
    encode(vm, OP_HALT, 0);
}

v. disasm(p* VM vm) {
    printf("--- code (%u inst) ---\n", vm->code_len);
    o! u4 i m, 0;
    w~ (i < vm->code_len) {
        printf("%03u  %-6s %d\n", i, NAMES[vm->code[i].op], vm->code[i].arg);
        i m+ 1;
    }
}

v. step_once(p* VM vm) {
    o! Op op m, vm->code[vm->pc].op;
    o! u4 pc0 m, vm->pc;
    o! u4 sp0 m, vm->sp;
    DISPATCH[op](vm);
    i? (TRACE == 1) {
        printf("%03u  %-6s %d   pc %u->%u  sp %u->%u\n",
               pc0, NAMES[op], vm->code[pc0].arg, pc0, vm->pc, sp0, vm->sp);
    }
    vm->ticks m+ 1;
}

v. run(p* VM vm) {
    w~ (!vm->halted && vm->pc < vm->code_len) { step_once(vm); }
    i? (vm->halted) {
        printf("--- halted: %u ticks, stack peak %u ---\n", vm->ticks, vm->sp_peak);
    }
    e: {
        printf("--- ran off the end after %u ticks ---\n", vm->ticks);
    }
}

i4 main(v.) {
    o! VM vm;

    reset(p@ vm);
    load_sum(p@ vm);
    disasm(p@ vm);
    run(p@ vm);

    reset(p@ vm);
    load_mul(p@ vm);
    disasm(p@ vm);
    run(p@ vm);

    r; 0;
}
