#include <stdio.h>

/* 第 1 章：变量、函数、打印
   o!  声明对象      m,  赋值
   r;  返回          v.  空参数 / 空类型 */

i4 area(i4 w, i4 h) { r; w * h; }

i4 main(v.) {
    o! i4 w m, 4;                 /* 声明 + 初始化 */
    o! i4 h m, 6;
    printf("Sigil-C tutorial\n");
    printf("area(%d x %d) = %d\n", w, h, area(w, h));
    r; 0;
}
