#include <stdio.h>

/* 第 4 章：函数指针表——把 if/else 换成分派表 */

e{ Op { ADD m, 0, SUB m, 1, MUL m, 2, DIV m, 3 };

i4 do_add(i4 a, i4 b) { r; a + b; }
i4 do_sub(i4 a, i4 b) { r; a - b; }
i4 do_mul(i4 a, i4 b) { r; a * b; }

i4 do_div(i4 a, i4 b) {
    i? (b =? 0) { r; 0; }
    r; a / b;
}

o! (f^(i4, i4) -> i4)[4] OPS m, { do_add, do_sub, do_mul, do_div };

i4 eval(i4 a, Op op, i4 b) { r; OPS[(i4)op](a, b); }

i4 main(v.) {
    printf("1+2=%d\n", eval(1, ADD, 2));
    printf("9-4=%d\n", eval(9, SUB, 4));
    printf("6*7=%d\n", eval(6, MUL, 7));
    printf("8/2=%d\n", eval(8, DIV, 2));
    printf("1/0=%d\n", eval(1, DIV, 0));
    r; 0;
}
