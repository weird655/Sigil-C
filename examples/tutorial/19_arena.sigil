#include <stdio.h>
#include <stdlib.h>

/* 第 19 章：Arena —— 把堆退化成栈
   - 分配 = 对齐 + 加法，O(1)
   - 回收 = 游标归零，O(1)，不分片
   - 适合"一次请求 / 一帧"里同生命周期的批量对象 */

s{ Arena { p* u1 base; u4 cap; u4 off; };

v. arena_init(p* Arena a, p* u1 base, u4 cap) {
    a->base m, base;
    a->cap m, cap;
    a->off m, 0;
}

p* u1 arena_alloc(p* Arena a, u4 size, u4 align) {
    o! u4 aligned m, (a->off + align - 1) &^ ~^(align - 1);
    o! u4 next m, aligned + size;
    i? (next > a->cap) { r; NULL; }
    a->off m, next;
    r; a->base + aligned;
}

v. arena_reset(p* Arena a) { a->off m, 0; }

i4 main(v.) {
    o! u1[64] buf;
    o! Arena a;
    arena_init(a& a, a& buf[0], 64);

    o! p* i4 x m, (p* i4)arena_alloc(a& a, 4, 4);
    i? (x =? NULL) { r; 1; }
    p* x m, 42;
    printf("x=%d off=%u\n", p* x, a.off);

    arena_reset(a& a);
    printf("after_reset=%u\n", a.off);
    r; 0;
}
